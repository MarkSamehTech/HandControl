<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖐️ تحكم بحركات الإيد"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="تحكم في موبايلك كله بإيدك من غير ما تلمس الشاشة"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- التجهيز -->
        <LinearLayout
            android:id="@+id/setupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="التجهيز (مرة واحدة)"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout style="@style/Row">
                <TextView android:id="@+id/txtCam" style="@style/RowText" />
                <Button android:id="@+id/btnCam" style="@style/SmallBtn" android:text="سماح" />
            </LinearLayout>
            <LinearLayout style="@style/Row">
                <TextView android:id="@+id/txtA11y" style="@style/RowText" />
                <Button android:id="@+id/btnA11y" style="@style/SmallBtn" android:text="تفعيل" />
            </LinearLayout>
            <LinearLayout style="@style/Row">
                <TextView android:id="@+id/txtNotif" style="@style/RowText" />
                <Button android:id="@+id/btnNotif" style="@style/SmallBtn" android:text="سماح" />
            </LinearLayout>
            <TextView
                android:id="@+id/txtRestricted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="لو الزرار &quot;تفعيل&quot; مش بيشتغل (أندرويد 13+): افتح معلومات التطبيق ← ⋮ ← &quot;السماح بالإعدادات المقيّدة&quot;، وبعدها فعّل الخدمة."
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btnAppInfo"
                style="@style/SmallBtn"
                android:layout_marginTop="6dp"
                android:text="فتح معلومات التطبيق" />
        </LinearLayout>

        <!-- الكاميرا -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg">

            <com.handgestures.mobile.CameraView
                android:id="@+id/cameraView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="#99000000"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="الكاميرا واقفة"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnToggle"
            style="@style/BigBtn"
            android:layout_marginTop="10dp"
            android:text="تشغيل التحكم" />
        <Button
            android:id="@+id/btnTouch"
            style="@style/BigBtn.Alt"
            android:text="🖐️ تشغيل وضع اللمس" />
        <Button
            android:id="@+id/btnKb"
            style="@style/BigBtn.Alt"
            android:text="⌨️ كيبورد الموبايل (إظهار / إخفاء)" />

        <!-- الضبط -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView android:id="@+id/lblGain" style="@style/Lbl" />
            <SeekBar android:id="@+id/seekGain" style="@style/Seek" android:max="220" />
            <TextView android:id="@+id/lblSmooth" style="@style/Lbl" />
            <SeekBar android:id="@+id/seekSmooth" style="@style/Seek" android:max="100" />
            <TextView android:id="@+id/lblPinch" style="@style/Lbl" />
            <SeekBar android:id="@+id/seekPinch" style="@style/Seek" android:max="100" />

            <CheckBox android:id="@+id/chkPointer" style="@style/Chk" android:text="إظهار نقطة التتبع على الشاشة (وضع اللمس)" />
            <CheckBox android:id="@+id/chkMini" style="@style/Chk" android:text="معاينة صغيرة للكاميرا فوق التطبيقات" />
            <CheckBox android:id="@+id/chkHaptics" style="@style/Chk" android:text="اهتزاز خفيف عند تنفيذ الأمر" />
        </LinearLayout>

        <TextView style="@style/H2" android:text="الأوامر" />
        <LinearLayout android:id="@+id/mapping" style="@style/Card" />

        <TextView style="@style/H2" android:text="القرصة في وضع اللمس" />
        <LinearLayout android:id="@+id/pinchMapping" style="@style/Card" />

        <TextView style="@style/H2" android:text="الحركات جوه وضع اللمس" />
        <LinearLayout android:id="@+id/touchMapping" style="@style/Card" />

        <Button
            android:id="@+id/btnReset"
            style="@style/BigBtn.Alt"
            android:layout_marginTop="14dp"
            android:text="استرجاع الإعدادات الافتراضية" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="نصيحة: ثبّت الموبايل على حامل والكاميرا الأمامية شايفة إيدك. اقفل الإضاءة الضعيفة عشان التتبع يبقى أدق."
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
